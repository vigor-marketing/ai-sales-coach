DATABASE_URL="file:./dev.db"
# Required. Use a unique randomly generated value with at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional: absolute persistent directory for all user-uploaded files.
# Production server: /opt/瑞兰特AI培训系统/数据/uploads
UPLOADS_DIR=""

# Required in production. List only the workbench origins allowed to embed this
# module. Do not use a wildcard and do not set X-Frame-Options: DENY/SAMEORIGIN.
# FRAME_ANCESTORS="'self' https://portal.example.com"
FRAME_ANCESTORS=""

# Optional comma-separated browser origins permitted to call this API cross-site.
# Leave empty when the workbench uses same-domain reverse proxying.
CORS_ORIGIN=""

# Historical uploads have been archived in the existing private CloudBase COS prefix:
# 瑞兰特AI培训系统/上传文件/
# Do not put CloudBase API Keys or Tencent Cloud SecretId/SecretKey in this file.
