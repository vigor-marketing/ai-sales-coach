DATABASE_URL="file:./dev.db"
JWT_SECRET="your-jwt-secret-change-in-production"
AUTH_MODE="local"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Workbench integration. Replace all example company domains before production deployment.
APP_BASE_PATH="/apps/ai-sales-coach"
PUBLIC_APP_URL="https://workbench.company.com/apps/ai-sales-coach"
WORKBENCH_ORIGIN="https://workbench.company.com"
CORS_ORIGIN="https://workbench.company.com"
FRAME_ANCESTORS="'self' https://workbench.company.com"
WORKBENCH_EVENT_WEBHOOK_URL=""

# OIDC is enforced when AUTH_MODE=oidc. Use hybrid only during a controlled migration.
OIDC_ISSUER="https://auth.company.com/realms/vigor"
OIDC_CLIENT_ID="ai-sales-coach"
OIDC_CLIENT_SECRET="__SET_IN_DEPLOYMENT_ONLY__"
OIDC_REDIRECT_URI="https://workbench.company.com/apps/ai-sales-coach/auth/callback"
# Optional: absolute persistent directory for all user-uploaded files.
# Production server: /opt/瑞兰特AI培训系统/数据/uploads
UPLOADS_DIR=""

# Optional CSP frame-ancestors rule for iframe embedding. Keep empty to allow
# embedding from trusted portals without sending the legacy X-Frame-Options header.
# For a restricted deployment, list trusted origins, for example:
# FRAME_ANCESTORS="'self' https://portal.example.com"
FRAME_ANCESTORS=""

# Historical uploads have been archived in the existing private CloudBase COS prefix:
# 瑞兰特AI培训系统/上传文件/
# Do not put CloudBase API Keys or Tencent Cloud SecretId/SecretKey in this file.
